# Copy to .env and fill in (scripts/cloudflare.sh fills in PORT, CF_TEAM_DOMAIN and CF_ACCESS_AUD).
HOST=127.0.0.1
PORT=7681
# Zero Trust team domain, e.g. myteam.cloudflareaccess.com
CF_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" from the Access application overview
CF_ACCESS_AUD=
# One Google account -> one Linux user (comma-separated). root is refused.
# Users other than the service's own need the root install: scripts/install-system.sh
IDENTITIES=you@example.com:youruser
