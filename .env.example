# Config for cloudflare-tmux. Lives at ~/.config/cloudflare-tmux/env (scripts/cloudflare.sh creates it and fills in
# PUBLIC_HOST, TUNNEL_NAME, PORT, CF_TEAM_DOMAIN and CF_ACCESS_AUD).
HOST=127.0.0.1
PORT=7681
# Zero Trust team domain, e.g. myteam.cloudflareaccess.com
CF_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" from the Access application overview
CF_ACCESS_AUD=
# One Cloudflare account email -> one Linux user (comma-separated). root is refused.
# Each person must be a member of your Cloudflare account (Minimal Account Access is enough).
# Users other than the service's own need the root install: scripts/install-system.sh
IDENTITIES=you@example.com:youruser
# Optional second step: a 6-digit authenticator code after Cloudflare login.
# Enroll people first with: scripts/totp.js add you@example.com
# TOTP=required
# TOTP_SESSION_HOURS=12
# TOTP_FILE=
