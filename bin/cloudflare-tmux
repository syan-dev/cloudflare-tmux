#!/usr/bin/env bash
# The cloudflare-tmux command. ./install.sh links it into ~/.local/bin.
#
# Usage:
#   cloudflare-tmux status                 is it online? services, tunnel, public URL, people
#   cloudflare-tmux people                 who may log in: Cloudflare email -> Linux user
#   cloudflare-tmux add <email> [user]     let someone log in (asks for an API token)
#   cloudflare-tmux remove <email>         lock someone out (no token)
#   cloudflare-tmux config                 show the configuration
#   cloudflare-tmux logs [-f]              app log (-f to follow)
#   cloudflare-tmux restart                restart the app the right way for this install
#   cloudflare-tmux doctor                 check everything and print the fix for anything wrong
#   cloudflare-tmux help
# Colors switch off when output is piped or NO_COLOR is set.
set -euo pipefail

SELF="$(readlink -f "$0")"
APP_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=scripts/config.sh
. "$APP_DIR/scripts/config.sh"
# shellcheck source=scripts/ui.sh
. "$APP_DIR/scripts/ui.sh"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

if [ -f /etc/systemd/system/cloudflare-tmux.service ]; then MODE=multi; else MODE=single; fi

usage() {
  printf '%s  %s\n\n' "$(bold cloudflare-tmux)" "$(dim 'tmux sessions in the browser, behind Cloudflare Access')"
  printf '%s\n' "$(dim 'Usage: cloudflare-tmux <command>')"
  help_line() { printf '  %s%-9s%s %s%-15s%s %s\n' "$C_BOLD" "$1" "$C_RESET" "$C_CYAN" "$2" "$C_RESET" "$3"; }
  help_line status  ""               "is it online? app, tunnel, public URL, people"
  help_line people  ""               "who may log in: Cloudflare email → Linux user"
  help_line add     "<email> [user]" "let someone log in (asks for an API token)"
  help_line remove  "<email>"        "lock someone out (no token needed)"
  help_line config  ""               "the configuration and where things live"
  help_line logs    "[-f]"           "the app log (-f to follow)"
  help_line restart ""               "restart the app the right way for this install"
  help_line doctor  ""               "check everything and print the fix for anything wrong"
  echo
  printf '%s %s\n' "$(dim 'Docs:')" "$(link https://syan-dev.github.io/cloudflare-tmux/)"
}

# app_ctl ARGS...: systemctl for the app service, system or user depending on the install
app_ctl() { if [ "$MODE" = multi ]; then systemctl "$@" cloudflare-tmux.service; else systemctl --user "$@" cloudflare-tmux.service; fi; }
app_journal() { if [ "$MODE" = multi ]; then journalctl -u cloudflare-tmux "$@"; else journalctl --user -u cloudflare-tmux "$@"; fi; }
# since SCOPE UNIT: SCOPE is "" (system) or --user. Prints "since <date> <time>".
since() { local t; t="$(systemctl ${1:+"$1"} show -p ActiveEnterTimestamp --value "$2" 2>/dev/null || true)"; [ -n "$t" ] && echo "since $(echo "$t" | cut -d' ' -f2-3)"; }

cmd_status() {
  local host port code n inv
  host="$(env_get PUBLIC_HOST)"; port="$(env_get PORT)"; port="${port:-7681}"
  [ -f "$ENV_FILE" ] || { bad "not installed: no config at $ENV_FILE"; fix "./install.sh"; return 1; }
  printf '\n%s  %s   %s\n\n' "$(bold cloudflare-tmux)" "$(link "https://${host:-?}")" "$(dim "$MODE-user install")"

  if app_ctl is-active -q; then
    if [ "$MODE" = multi ]; then row app "$(up running) $(dim "$(since "" cloudflare-tmux.service)")"
    else row app "$(up running) $(dim "$(since --user cloudflare-tmux.service)")"; fi
  else row app "$(down 'not running')   $(dim 'see: cloudflare-tmux logs')"; fi

  if systemctl --user is-active -q cloudflare-tmux-cloudflared.service; then
    inv="$(systemctl --user show -p InvocationID --value cloudflare-tmux-cloudflared.service 2>/dev/null || true)"
    n="$(journalctl --user --no-pager ${inv:+_SYSTEMD_INVOCATION_ID=$inv} -u cloudflare-tmux-cloudflared 2>/dev/null | grep -c 'Registered tunnel connection' || true)"
    row tunnel "$(up running) $(dim "$(since --user cloudflare-tmux-cloudflared.service)${n:+, $n connection(s) to Cloudflare}")"
  else row tunnel "$(down 'not running')   $(dim 'see: journalctl --user -u cloudflare-tmux-cloudflared -n 30')"; fi

  if [ -n "$host" ]; then
    code="$(curl -sI -m 8 "https://$host/" 2>/dev/null | awk 'NR==1{print $2}')"
    case "$code" in
      302) row public "$(up 'login page is up') $(dim "https://$host redirects to Cloudflare Access")" ;;
      "")  row public "$(down 'no answer') $(dim "https://$host: DNS or network")" ;;
      530) row public "$(down 'tunnel not connected') $(dim 'Cloudflare error 1033')" ;;
      *)   row public "$(down "HTTP $code") $(dim 'expected a 302 to the login page')" ;;
    esac
  else row public "$(down 'no hostname in config')"; fi

  code="$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:$port/" || true)"
  if [ "$code" = 401 ]; then row local "$(up "port $port answers") $(dim 'and asks for a login, as it should')"
  else row local "$(down "port $port: HTTP ${code:-none}")"; fi

  n="$(env_get IDENTITIES | tr ',' '\n' | sed '/^ *$/d' | wc -l)"
  row people "$(bold "$n") $(dim 'may log in     see: cloudflare-tmux people')"
  row config "$(dim "$ENV_FILE")"
  echo
  note "More detail: cloudflare-tmux doctor"
}

cmd_config() {
  [ -f "$ENV_FILE" ] || { bad "no config at $ENV_FILE"; fix "./install.sh"; return 1; }
  title "Config file  $(dim "$ENV_FILE")"
  [ "$MODE" = multi ] && note "running copy: /etc/cloudflare-tmux/env (root only; refreshed by cloudflare-tmux restart)"
  echo
  grep -E '^[A-Z_]+=' "$ENV_FILE" | awk -F= -v d="$C_DIM" -v r="$C_RESET" \
    '{ k=$1; sub(/^[^=]*=/, ""); printf "  %s%-20s%s %s\n", d, k, r, ($0 == "" ? d "(empty)" r : $0) }'
  title "Install"
  if [ "$MODE" = multi ]; then row mode "multi-user $(dim '· the app runs as root and serves every mapped Linux user')"
  else row mode "single-user $(dim "· the app runs as $USER and serves only $USER")"; fi
  row code "$(if [ "$MODE" = multi ]; then echo /opt/cloudflare-tmux; else echo "$APP_DIR"; fi)"
  row tunnel "$HOME/.cloudflared/cloudflare-tmux.token"
  echo
  note "Edit the file, then: cloudflare-tmux restart.  People: use add / remove instead."
}

cmd_restart() {
  if [ "$MODE" = multi ]; then
    note "Re-installing the root service (sudo may ask for your password)..."
    sudo NODE_BIN="$(command -v node)" ENV_FILE="$ENV_FILE" "$APP_DIR/scripts/install-system.sh"
  else
    systemctl --user restart cloudflare-tmux.service
  fi
  cmd_status
}

case "${1:-help}" in
  status|st) cmd_status ;;
  people|list|ls) exec "$APP_DIR/scripts/people.sh" list ;;
  add|remove) exec "$APP_DIR/scripts/people.sh" "$@" ;;
  config|cfg) cmd_config ;;
  logs|log) shift; app_journal --no-pager -n 50 "$@" 2>/dev/null || { bad "can't read the log as $USER"; fix "sudo journalctl -u cloudflare-tmux -n 50"; exit 1; } ;;
  restart) cmd_restart ;;
  doctor) exec "$APP_DIR/scripts/doctor.sh" ;;
  install|setup) shift; exec "$APP_DIR/install.sh" "$@" ;;
  help|-h|--help) usage ;;
  *) bad "unknown command: $1"; echo; usage; exit 1 ;;
esac
